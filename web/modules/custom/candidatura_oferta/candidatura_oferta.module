<?php

use Drupal\Core\Form\FormStateInterface;
use Drupal\node\Entity\Node;
use Drupal\Core\Entity\EntityInterface;

/**
 * Altera o formulário de candidatura para preencher a oferta automaticamente.
 */
function candidatura_oferta_form_node_candidatura_form_alter(array &$form, FormStateInterface $form_state, $form_id) {
  // Obter o ID da oferta da query string
  $oferta_id = \Drupal::request()->query->get('oferta');

  if ($oferta_id && is_numeric($oferta_id)) {
    $node = Node::load($oferta_id);
    if ($node && $node->bundle() == 'oferta_de_emprego') {
      // Preencher automaticamente o campo da oferta
      $form['field_oferta_de_emprego']['widget'][0]['target_id']['#default_value'] = $node;

      // Exibir a oferta no topo do formulário
      $form['resumo_oferta'] = [
        '#type' => 'item',
        '#title' => t('Está a candidatar-se a:'),
        '#markup' => '<strong>' . $node->label() . '</strong><br><div>' . $node->get('field_descricao')->value . '</div>',
        '#weight' => -10,
      ];
    }
  }
}

/**
 * Define o estado inicial da candidatura como "recebida".
 */
function candidatura_oferta_node_presave(EntityInterface $entity) {
  if ($entity->getEntityTypeId() === 'node' && $entity->bundle() === 'candidatura' && $entity->isNew()) {
    $entity->set('field_estado_da_candidatura', 'recebida');
  }
}
