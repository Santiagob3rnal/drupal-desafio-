<div class="card h-100">
  <div class="card-body">
    {% for key, field in fields %}
      {% if key != 'nid' %}
        {% if field.label %}
          <h5 class="card-title">{{ field.label }}</h5>
        {% endif %}
        <div class="card-text">{{ field.content }}</div>
      {% endif %}
    {% endfor %}

    {% set oferta_id = fields.nid.content|striptags|trim %}
    <div class="mt-3 text-end">
      <a href="{{ path('entity.node.canonical', {'node': oferta_id}) }}" class="btn btn-sm btn-outline-primary">
        <i class="bi bi-info-circle me-1"></i> Ver mais detalhes
      </a>
    </div>
  </div>
</div>
