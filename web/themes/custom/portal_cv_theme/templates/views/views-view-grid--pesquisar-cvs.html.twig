{% if title %}
  <h3>{{ title }}</h3>
{% endif %}

<div class="cv-grid">
  <div{{ attributes.addClass('row') }}>
    {% for row in rows %}
      <div class="col-md-4 col-sm-6 mb-4">
        <div class="cv-card h-100">
          {{ row.content }}
        </div>
      </div>
    {% endfor %}
  </div>
</div>
